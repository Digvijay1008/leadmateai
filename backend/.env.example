# =================================================================
#  LEADMATE BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
#  -----------------------------------------------------------------
#  Copy this file to .env and fill in your own values.
#  Never commit your real .env file to version control.
#  cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# -----------------------------------------------------------------
PORT=3001
NODE_ENV=development

# -----------------------------------------------------------------
# 2. DATABASE (SUPABASE / POSTGRESQL)
# -----------------------------------------------------------------
# Get this from: Supabase → Project Settings → Database → Connection String
# Use port 5432 (Session Mode), NOT 6543 (Transaction Pooler)
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Optional: Supabase project URL for future extensions
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_SERVICE_KEY=

# -----------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------
# REQUIRED: Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_RANDOM_32_CHAR_SECRET_STRING

JWT_EXPIRES_IN=7d

# SIP credential encryption key (optional, for encrypted SIP creds storage)
SIP_ENCRYPTION_KEY=

# -----------------------------------------------------------------
# 4. LIVEKIT CLOUD (REALTIME INFRASTRUCTURE)
# -----------------------------------------------------------------
# Get all these from: https://cloud.livekit.io → Your Project → Settings
LIVEKIT_URL=wss://[YOUR_PROJECT_NAME].livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Must match the 'name' your agent worker registers with.
LIVEKIT_AGENT_NAME=leadmate-agent

# -----------------------------------------------------------------
# 5. AI PROVIDERS (CORE INTELLIGENCE)
# -----------------------------------------------------------------

# OpenAI — Required for Embeddings/RAG. Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Deepgram — Required for STT (Speech-to-Text). Get key: https://console.deepgram.com
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY

# ElevenLabs — Required for "Growth" preset TTS. Get key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Groq — Required for "Lightning Fast" preset. Get key: https://console.groq.com/keys
GROQ_API_KEY=

# Gemini — Required for "Google Advanced" preset. Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Sarvam — Required for "Sarvam India Stack" preset. Get key: https://dashboard.sarvam.ai/
SARVAM_API_KEY=

# -----------------------------------------------------------------
# 6. BILLING & WALLET CONFIGURATION
# -----------------------------------------------------------------
DEFAULT_CURRENCY=INR
LOW_BALANCE_THRESHOLD=50
MIN_SESSION_BALANCE_MINUTES=1
HOLD_AMOUNT_MULTIPLIER=1.2

# -----------------------------------------------------------------
# 7. FUTURE EXTENSIONS (PLACEHOLDERS)
# -----------------------------------------------------------------
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RESEND_API_KEY=
